JWT_SECRET=super_secret_cryptographic_key_12345
PORT=3000

# Please update the following with your database and email credentials
DATABASE_URL="postgresql://user:password@host:port/database"

# Example for a Gmail account.
# IMPORTANT: If you use 2-Factor Authentication (2FA), you must generate an 
# "App Password" in your Google Account security settings and use it for EMAIL_PASS.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your.email@gmail.com"
EMAIL_PASS="your_gmail_password_or_app_password"
EMAIL_FROM="your.email@gmail.com"
